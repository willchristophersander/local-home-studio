{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Short room name."
    },
    "width": {
      "type": "number",
      "exclusiveMinimum": 0.3,
      "maximum": 100,
      "description": "Centreline width in metres, west to east."
    },
    "depth": {
      "type": "number",
      "exclusiveMinimum": 0.3,
      "maximum": 100,
      "description": "Centreline depth in metres, south to north."
    },
    "height": {
      "type": "number",
      "exclusiveMinimum": 0.3,
      "maximum": 30,
      "description": "Wall height in metres, from the floor to the top of the wall."
    },
    "floorElevation": {
      "type": "number",
      "minimum": -100,
      "maximum": 100,
      "description": "Floor height in metres. Use 0 when the request does not say otherwise."
    },
    "wallThickness": {
      "type": "number",
      "minimum": 0.02,
      "maximum": 2,
      "description": "Wall thickness in metres. Use 0.2 unless the photograph shows otherwise."
    },
    "openings": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "wall": {
            "type": "string",
            "enum": [
              "south",
              "east",
              "north",
              "west"
            ]
          },
          "kind": {
            "type": "string",
            "enum": [
              "door",
              "window"
            ]
          },
          "offset": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "width": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          },
          "sill": {
            "type": "number",
            "minimum": 0,
            "maximum": 30
          },
          "height": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 30
          }
        },
        "required": [
          "wall",
          "kind",
          "offset",
          "width",
          "sill",
          "height"
        ],
        "additionalProperties": false
      },
      "description": "Doors and windows. Offset follows the wall walk in the controls."
    },
    "unseen": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "description": "Walls, dimensions, or adjoining rooms the pictures do not settle."
    },
    "assumptions": {
      "maxItems": 40,
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      },
      "description": "Numbers you chose, including a visual estimate replaced by a locked measurement."
    }
  },
  "required": [
    "schemaVersion",
    "name",
    "width",
    "depth",
    "height",
    "floorElevation",
    "wallThickness",
    "openings",
    "unseen",
    "assumptions"
  ],
  "additionalProperties": false
}
